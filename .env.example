# Persistence
JIEYI_DB=jieyi.db
JIEYI_CONFIG=jieyi.settings.json

# Optional OpenAI-compatible provider. Keep real secrets out of this file.
JIEYI_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
JIEYI_OPENAI_API_KEY=

# GUI provider profiles can use JIEYI_API_KEY_<PROFILE_ID>.
# Example profile id "kimi-coding":
JIEYI_API_KEY_KIMI_CODING=
